<Window x:Class="DynamicWallpaper.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="壁纸预览"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0B0F1A"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- 蓝紫渐变强调色（与主窗口一致） -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- 深色图标按钮 -->
        <Style x:Key="DarkIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B8C0CC"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色背景主按钮 -->
        <Style x:Key="DarkPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Padding="22,0"
                                Background="{StaticResource AccentGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 关闭 -->
        <Grid Grid.Row="0" Background="#111722">
            <TextBlock x:Name="TitleText" Margin="18,0,60,0"
                       Foreground="White" FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Button Style="{StaticResource DarkIconButton}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,12,0" Click="OnClose"
                    ToolTip="关闭（Esc）">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
            </Button>
        </Grid>

        <!-- 内容：图片大图 / 视频播放（WebView2 与壁纸播放同一 Chromium 引擎，保证可播） -->
        <Grid Grid.Row="1" Background="#0B0F1A">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="20"/>
            <wv2:WebView2 x:Name="PreviewVideoView" Margin="20" Visibility="Collapsed"
                          DefaultBackgroundColor="#000000"/>
            <TextBlock x:Name="VideoFailText" Visibility="Collapsed"
                       Foreground="#8B94A3" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="当前视频格式不支持内置预览播放，仍可设为壁纸（壁纸使用 WebView2 播放）"/>

            <!-- 在线内容下载中的加载遮罩（预览窗先弹出，内容就绪后自动展示） -->
            <Border x:Name="LoadingOverlay" Background="#B30B0F1A" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingGlyph" Text="&#xE896;"
                               FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="#6366F1" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText" Text="正在下载高清内容，请稍候…"
                               Foreground="#C8D0DC" FontSize="14" Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="220" Height="4"
                                 Margin="0,18,0,0" BorderThickness="0"
                                 Foreground="{StaticResource AccentGradientBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底栏：设为壁纸 -->
        <Border Grid.Row="2" Background="#111722" Padding="0,11">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ApplyBtn" Style="{StaticResource DarkPrimaryBtn}"
                        Content="设为壁纸" Click="OnApply"/>
                <TextBlock Text="设为壁纸后将保存到正式图库"
                           Foreground="#8B94A3" FontSize="11.5"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
